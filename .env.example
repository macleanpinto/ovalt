# ============================================
# Tag Relay Environment Configuration
# ============================================
#
# ⚠️  SECURITY NOTICE:
# - This file is for LOCAL DEVELOPMENT ONLY
# - NEVER commit real credentials to Git
# - Production secrets go in AWS Secrets Manager
# - See README.md for production setup
#
# Classification:
# 🔓 PUBLIC - Can be committed or set as GitHub Variables
# 🔐 SECRET - Must use AWS Secrets Manager (production)
#

# ============================================
# Environment
# ============================================
ENVIRONMENT=local
# Options: local, production

# ============================================
# AWS Configuration
# ============================================
AWS_REGION=us-east-1

# LOCAL ONLY - LocalStack for development
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# DynamoDB Tables
# Auth tables are hardcoded with "tag-relay-" prefix
# Only imports/runs are configurable:
DDB_TABLE_IMPORTS=tag-relay-imports
DDB_TABLE_RUNS=tag-relay-runs

# S3 Bucket
S3_BUCKET=tag-relay-artifacts

# SQS Queue
SQS_QUEUE_URL=http://localhost:4566/000000000000/tag-relay-migrations

# ============================================
# Application URLs
# ============================================
WEB_BASE_URL=http://localhost:5173

# Next.js (web-nextjs) — GTM container on ovalt.org / local dev
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ============================================
# Secrets (AWS Secrets Manager in Production)
# ============================================
# 🔐 For local development, set these here
# 🔐 For production, use: ./scripts/setup-secrets.sh production
# Generate secure values: openssl rand -base64 32

JWT_SECRET=dev-jwt-secret-change-in-production
API_KEY=dev-api-key-change-in-production
SERVICE_TOKEN=dev-service-token-change-in-production

# ============================================
# OAuth - User Authentication
# ============================================
# 🔐 Use ONE Google OAuth client with BOTH redirect URIs:
#   - http://localhost:3001/auth/oauth/google/callback (login)
#   - http://localhost:3001/gtm/oauth/callback (GTM access)
# Google: https://console.cloud.google.com/apis/credentials
# Enable: Tag Manager API, Cloud Resource Manager API
# GitHub: https://github.com/settings/developers

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/auth/oauth/google/callback

# OAuth - GTM / Tag Manager Access (recommended: use a separate OAuth client)
GTM_OAUTH_CLIENT_ID=
GTM_OAUTH_CLIENT_SECRET=
GTM_OAUTH_REDIRECT_URI=http://localhost:3001/gtm/oauth/callback

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3001/auth/oauth/github/callback

# ============================================
# Optional — Ovalt GTM engagement script (local)
# ============================================
# npm run setup:ovalt-gtm -w @tag-relay/api
# First (saves refresh token into .env): npm run setup:ovalt-gtm:auth:save -w @tag-relay/api
# (Add http://127.0.0.1:8765/oauth/callback to the OAuth client redirect URIs.)
#
# OVALT_GTM_CLIENT_ID=
# OVALT_GTM_CLIENT_SECRET=
# OVALT_GTM_REFRESH_TOKEN=   # or GTM_OAUTH_REFRESH_TOKEN= (from: npm run setup:ovalt-gtm:auth -w @tag-relay/api)
# Target (one of): paste browser URL, full path, or account+container IDs
# Quote the URL — unquoted values break at # (dotenv treats # as comment). Script also re-reads .env raw.
# OVALT_GTM_CONTAINER_URL="https://tagmanager.google.com/#/container/accounts/ACC/containers/CONT/workspaces/2"
# OVALT_GTM_WORKSPACE_PATH=accounts/ACCOUNT_ID/containers/CONTAINER_ID/workspaces/WORKSPACE_ID
# OVALT_GTM_ACCOUNT_ID=
# OVALT_GTM_CONTAINER_ID=
# OVALT_GTM_WORKSPACE_ID=   # optional; e.g. 2
# OVALT_GA4_MEASUREMENT_ID=G-XXXXXXXX  # optional; creates GA4 Event tags

# ============================================
# Optional - AI-Assisted Mapping
# ============================================
# 🔐 Optional - Used for provisional confidence scoring
# when no documentation exists for a tag type

# ============================================
# Production Deployment
# ============================================
#
# For production, use AWS Secrets Manager:
#
# 1. Setup secrets:
#    ./scripts/setup-secrets.sh production
#
# 2. Deploy Lambda functions:
#    ./scripts/deploy-lambda.sh all
#    ./scripts/deploy-web-ssr.sh
#
# 3. Secrets loaded automatically at Lambda startup
#
# 4. Lambda execution role needs:
#    - secretsmanager:GetSecretValue
#    - dynamodb:*, s3:*, sqs:*
#
# See README.md
#
