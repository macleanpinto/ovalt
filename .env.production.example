# AWS Configuration
AWS_PROFILE=tagrelay-prod
AWS_REGION=eu-north-1

# Environment
ENVIRONMENT=production

# API URL for Next.js build
# After first deployment, get this from:
# aws cloudformation describe-stacks --stack-name tag-relay-api-production \
#   --query 'Stacks[0].Outputs[?OutputKey==`ApiUrl`].OutputValue' --output text
#
# Example: https://abc123xyz.execute-api.eu-north-1.amazonaws.com
NEXT_PUBLIC_API_URL=https://your-api-gateway-url.execute-api.eu-north-1.amazonaws.com

# These are loaded from AWS Secrets Manager at runtime (do NOT set here):
# - JWT_SECRET
# - API_KEY
# - SERVICE_TOKEN
# - GOOGLE_OAUTH_CLIENT_ID
# - GOOGLE_OAUTH_CLIENT_SECRET
# - GOOGLE_OAUTH_REDIRECT_URI (use API Gateway URL, not custom domain)
# - GITHUB_OAUTH_CLIENT_ID
# - GITHUB_OAUTH_CLIENT_SECRET
# - GITHUB_OAUTH_REDIRECT_URI (use API Gateway URL, not custom domain)
# - GTM_OAUTH_REDIRECT_URI (use API Gateway URL, not custom domain)
