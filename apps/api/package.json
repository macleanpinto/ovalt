{
  "name": "@tag-relay/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:ovalt-gtm": "node scripts/setup-ovalt-gtm-engagement.mjs",
    "setup:ovalt-gtm:create-workspace": "node scripts/setup-ovalt-gtm-engagement.mjs --create-workspace",
    "setup:ovalt-gtm:reset": "node scripts/setup-ovalt-gtm-engagement.mjs --delete-all-tags --delete-all-triggers",
    "setup:ovalt-gtm:auth": "node scripts/setup-ovalt-gtm-engagement.mjs --authorize",
    "setup:ovalt-gtm:auth:save": "node scripts/setup-ovalt-gtm-engagement.mjs --authorize --write-env",
    "test:e2e": "node scripts/run-e2e-with-oauth.mjs",
    "test:browser-e2e": "npm test -- browser-e2e-test.test.ts",
    "dev": "tsx watch src/index.ts",
    "dev:test": "NODE_ENV=test tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "build:lambda": "node build-lambda.js",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.888.0",
    "@aws-sdk/client-s3": "^3.888.0",
    "@aws-sdk/client-secrets-manager": "^3.1022.0",
    "@aws-sdk/client-sesv2": "^3.1041.0",
    "@aws-sdk/client-sqs": "^3.888.0",
    "@aws-sdk/lib-dynamodb": "^3.888.0",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "aws-lambda-fastify": "^2.2.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.0.0",
    "googleapis": "^171.4.0",
    "jose": "^5.9.6",
    "pino": "^9.0.0",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/aws-lambda": "^8.10.161",
    "@types/aws-lambda-fastify": "^1.4.5",
    "@types/node": "^22.0.0",
    "aws-sdk-client-mock": "^4.1.0",
    "playwright": "^1.59.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
